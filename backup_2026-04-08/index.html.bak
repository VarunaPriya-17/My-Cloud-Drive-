<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CloudDrive | Your Secure Cloud Ecosystem</title>
    <link rel="stylesheet" href="styles.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Auth Experience (Full Page) -->
    <div id="auth-screen" class="auth-screen">
        <div class="auth-card glass-modal">
            <div class="auth-header">
                <i class="fas fa-cloud fa-3x"></i>
                <h1>Welcome to CloudDrive</h1>
                <p>Your secure, high-performance cloud storage.</p>
            </div>
            
            <form id="auth-form" class="auth-form">
                <div class="input-group">
                    <i class="fas fa-envelope"></i>
                    <input type="email" id="auth-email" placeholder="Email Address" required>
                </div>
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="auth-password" placeholder="Password" required>
                </div>
                <button type="submit" class="btn-primary full-width-btn">
                    <span id="auth-btn-text">Get Started</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>
            
            <div class="auth-footer">
                <p id="auth-toggle-text">New here? <a href="#" id="toggle-auth-mode">Create an Account</a></p>
            </div>
        </div>
    </div>

    <!-- Dashboard Container -->
    <div id="dashboard-container" class="dashboard-container hidden">
        <div id="app-shell" class="glass-container">
            <!-- Sidebar Navigation -->
            <aside id="sidebar" class="sidebar">
                <div class="logo">
                    <i class="fas fa-cloud"></i>
                    <span>CloudDrive</span>
                </div>
                
                <nav class="nav-links">
                    <button class="nav-item active" id="btn-my-drive">
                        <i class="fas fa-folder-open"></i> <span>My Drive</span>
                    </button>
                    <button class="nav-item" id="btn-recent">
                        <i class="fas fa-clock"></i> <span>Recent</span>
                    </button>
                    <button class="nav-item" id="btn-starred">
                        <i class="fas fa-star"></i> <span>Starred</span>
                    </button>
                    <button class="nav-item" id="btn-folders">
                        <i class="fas fa-folder"></i> <span>Folders</span>
                    </button>
                    <button class="nav-item" id="btn-trash">
                        <i class="fas fa-trash"></i> <span>Trash</span>
                    </button>
                </nav>

                <div class="storage-stats">
                    <div class="storage-info">
                        <p>Storage Used</p>
                        <span id="storage-status">0 / 25 GB</span>
                    </div>
                    <div class="progress-bar">
                        <div id="progress-indicator" style="width: 0%;"></div>
                    </div>
                </div>

                <div class="profile-section">
                    <div id="user-profile" class="profile-card">
                        <div class="avatar"><i class="fas fa-user"></i></div>
                        <div class="user-info">
                            <p id="user-name">Guest User</p>
                            <button id="btn-logout" class="btn-text">Logout</button>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main id="main-content">
                <header class="top-header">
                    <div class="search-bar">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search your files..." id="file-search">
                    </div>
                    <div class="header-actions">
                        <button id="btn-new-folder" class="btn-secondary">
                            <i class="fas fa-folder-plus"></i> <span class="btn-lbl">New Folder</span>
                        </button>
                        <button id="btn-upload" class="btn-primary">
                            <i class="fas fa-plus"></i> <span class="btn-lbl">Upload</span>
                        </button>
                    </div>
                </header>

                <section id="content-display" class="content-display">
                    <div class="view-header">
                        <div class="view-title-container">
                            <h1 id="view-title">My Drive</h1>
                            <div id="breadcrumb-container" class="breadcrumb-container">
                                <!-- Breadcrumbs will be injected here -->
                            </div>
                        </div>
                        <div class="view-options">
                            <button class="view-btn active" id="btn-grid-view"><i class="fas fa-th-large"></i></button>
                            <button class="view-btn" id="btn-list-view"><i class="fas fa-list"></i></button>
                        </div>
                    </div>

                    <!-- Empty State -->
                    <div id="empty-state" class="empty-state">
                        <div class="empty-illustration">
                            <i class="fas fa-cloud-upload-alt pulse-animation"></i>
                        </div>
                        <h2>No Files Found</h2>
                        <p>Drag and drop files here or click "Upload" to get started.</p>
                    </div>

                    <!-- File Grid -->
                    <div id="file-grid" class="file-grid hidden">
                        <!-- Files will be injected here -->
                    </div>
                </section>
            </main>
        </div>
    </div>

    <!-- Modals (Global overlay) -->
    <div id="modal-container" class="modal-overlay hidden">
        <!-- Share Modal -->
        <div id="share-modal" class="modal-content glass-modal hidden">
            <div class="modal-header">
                <div class="modal-icon"><i class="fas fa-share-nodes"></i></div>
                <h2>Share Insight</h2>
                <p>Choose how you'd like to share this file.</p>
            </div>
            <div class="share-options-grid">
                <button class="share-option-btn" id="btn-share-file">
                    <i class="fas fa-file-export"></i>
                    <span>Share as File</span>
                </button>
                <button class="share-option-btn" id="btn-share-link">
                    <i class="fas fa-link"></i>
                    <span>Share as Link</span>
                </button>
                <button class="share-option-btn" id="btn-copy-link">
                    <i class="fas fa-copy"></i>
                    <span>Copy Link</span>
                </button>
            </div>
            <div class="share-box hidden">
                <input type="text" id="share-link-input" readonly>
            </div>
            <button class="btn-close-modal"><i class="fas fa-times"></i></button>
        </div>

        <!-- Rename Modal -->
        <!-- Rename Modal -->
        <div id="rename-modal" class="modal-content glass-modal hidden">
            <div class="modal-header">
                <div class="modal-icon"><i class="fas fa-edit"></i></div>
                <h2>Rename File</h2>
                <p>Choose a new name for your file.</p>
            </div>
            <form id="rename-form" class="auth-form">
                <div class="input-group">
                    <i class="fas fa-file-signature"></i>
                    <input type="text" id="rename-input" placeholder="New File Name" required>
                </div>
                <button type="submit" class="btn-primary full-width-btn">Confirm Rename</button>
            </form>
            <button class="btn-close-modal"><i class="fas fa-times"></i></button>
        </div>

        <!-- New Folder Modal -->
        <div id="folder-modal" class="modal-content glass-modal hidden">
            <div class="modal-header">
                <div class="modal-icon"><i class="fas fa-folder-plus"></i></div>
                <h2>Create New Folder</h2>
                <p>Give your new folder a name.</p>
            </div>
            <form id="folder-form" class="auth-form">
                <div class="input-group">
                    <i class="fas fa-folder"></i>
                    <input type="text" id="folder-input" placeholder="Folder Name" required>
                </div>
                <button type="submit" id="btn-create-folder-confirm" class="btn-primary full-width-btn">Create Folder</button>
            </form>
            <button class="btn-close-modal"><i class="fas fa-times"></i></button>
        </div>

        <!-- Move to Trash Modal -->
        <div id="trash-modal" class="modal-content glass-modal hidden">
            <div class="modal-header">
                <div class="modal-icon warning"><i class="fas fa-trash-alt"></i></div>
                <h2>Move to Trash?</h2>
                <p>The file will be moved to the Trash view. You can restore it later.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" id="btn-cancel-trash">Cancel</button>
                <button type="button" class="btn-primary" id="btn-confirm-trash">Move to Trash</button>
            </div>
            <button class="btn-close-modal"><i class="fas fa-times"></i></button>
        </div>

        <!-- Delete Forever Modal -->
        <div id="delete-forever-modal" class="modal-content glass-modal hidden">
            <div class="modal-header">
                <div class="modal-icon danger pulse-animation"><i class="fas fa-exclamation-triangle"></i></div>
                <h2>Permanently Delete?</h2>
                <p>This action cannot be undone. The file will be lost forever.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" id="btn-cancel-delete">Cancel</button>
                <button type="button" class="btn-primary danger-btn" id="btn-confirm-delete">Delete Forever</button>
            </div>
            <button class="btn-close-modal"><i class="fas fa-times"></i></button>
        </div>

        <!-- Storage Alerts -->
        <div id="alert-15gb" class="modal-content glass-modal hidden">
            <div class="modal-header">
                <div class="modal-icon warning"><i class="fas fa-hdd"></i></div>
                <h2>Storage Alert</h2>
                <p>You have crossed 15GB of your 25GB cloud storage.</p>
            </div>
            <button class="btn-primary full-width-btn btn-close-modal">Understood</button>
        </div>

        <div id="alert-20gb" class="modal-content glass-modal hidden">
            <div class="modal-header">
                <div class="modal-icon danger pulse-animation"><i class="fas fa-exclamation-circle"></i></div>
                <h2>Storage Urgent</h2>
                <p>You have crossed 20GB. Please remove unwanted files to free up space.</p>
            </div>
            <button class="btn-primary full-width-btn btn-close-modal">Manage Storage</button>
        </div>

        <div id="alert-1gb-file" class="modal-content glass-modal hidden">
            <div class="modal-header">
                <div class="modal-icon"><i class="fas fa-compress-alt"></i></div>
                <h2>File Too Large</h2>
                <p>Single files over 1GB are not allowed. Please compress below 1GB and try again.</p>
            </div>
            <button class="btn-primary full-width-btn btn-close-modal">Go Back</button>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast-container" class="toast-container"></div>

    <!-- Cloudinary Widget Script -->
    <script src="https://widget.cloudinary.com/v2.0/global/all.js" type="text/javascript"></script>
    <!-- Firebase SDKs -->
    <script type="module" src="app.js"></script>
</body>
</html>
